{
  "name": "matu",
  "version": "3.0.0",
  "description": "码途：面向自学者的中文编程阅读课程 Android App",
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 4173 --directory www",
    "test": "node --test \"tests/*.test.mjs\"",
    "sync": "node scripts/build-matu.mjs && npx cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "keywords": [
    "android",
    "capacitor",
    "vocabulary",
    "tts",
    "pronunciation",
    "spaced-repetition"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@capacitor/cli": "^8.5.3",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "hypher": "^0.2.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "syllable": "^5.0.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.45"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
