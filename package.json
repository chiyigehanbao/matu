{
  "name": "codelingo",
  "version": "3.0.0",
  "description": "码途：面向自学者的中文编程阅读课程 Android App",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "serve": "python -m http.server 4173 --directory www",
    "build:data": "node scripts/build_data.mjs && node scripts/export_words.mjs",
    "gen:audio": "python scripts/gen_audio.py --voices aria guy",
    "shrink:audio": "python scripts/shrink_audio.py",
    "clean:audio": "python scripts/clean_audio.py",
    "gen:icons": "node scripts/gen_icons.mjs",
    "check:syllables": "node scripts/check_syllables.mjs",
    "sync": "node scripts/build-matu.mjs && npx cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run sync && cd android && gradlew.bat assembleRelease"
  },
  "keywords": [
    "android",
    "capacitor",
    "vocabulary",
    "tts",
    "pronunciation",
    "spaced-repetition"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@capacitor/cli": "^8.5.3",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "hypher": "^0.2.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "syllable": "^5.0.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.45"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
